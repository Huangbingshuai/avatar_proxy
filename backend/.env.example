# 火山素材库、资源项目校验及方舟用量查询：服务端 AK/SK，绝不能下发给浏览器或 API 用户。
# IAM 身份需要具备 iam:GetProject 及 GetInferenceUsage 只读权限。
VOLCENGINE_ACCESS_KEY=your_access_key
VOLCENGINE_SECRET_KEY=your_secret_key

# Seedance：方舟推理 API Key，独立于上面的 AK/SK
SEEDANCE_ARK_API_KEY=your_ark_api_key
SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# TOS 文件中转。AK/SK 留空时复用 VOLCENGINE_ACCESS_KEY/SECRET_KEY
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_ENDPOINT=tos-cn-beijing.volces.com
TOS_REGION=cn-beijing
TOS_BUCKET=replace_with_real_bucket
TOS_PUBLIC_BASE_URL=https://assets.example.com
UPLOAD_MAX_BYTES=209715200
FFPROBE_PATH=ffprobe

# 内部控制台管理员会话。生产 HTTPS 必须为 true；仅本地 HTTP 验收设为 false。
ADMIN_COOKIE_SECURE=true
ADMIN_SESSION_IDLE_SECONDS=1800
ADMIN_SESSION_ABSOLUTE_SECONDS=43200

# 超级管理员强制 TOTP。生产建议显式配置加密主密钥：
# python -m app.admin_cli generate-totp-key
# 若留空，单实例会在 SQLite 同目录创建权限收紧的 admin_totp.key；恢复时必须连同该文件备份。
ADMIN_TOTP_ISSUER=Avatar Proxy
ADMIN_TOTP_ENCRYPTION_KEY=
ADMIN_TOTP_VALID_WINDOW=1

# 连续错误密码的账号级保护；IP 只写入审计，不参与限制或白名单判断。
ADMIN_LOGIN_WINDOW_SECONDS=900
ADMIN_LOGIN_LOCK_SECONDS=900
ADMIN_LOGIN_MAX_FAILURES=5

# Argon2id 密码哈希参数。除非完成容量评估，不要在生产环境降低这些值。
ADMIN_ARGON2_TIME_COST=3
ADMIN_ARGON2_MEMORY_COST=65536
ADMIN_ARGON2_PARALLELISM=4

# 单实例可使用容器持久卷中的 SQLite。多实例部署必须改为共享数据库后再横向扩容
DATABASE_PATH=./data/avatar_proxy.db

# SQLite 与管理员审计 JSONL 自动备份。默认保存到 SQLite 同目录的 backups/。
# 每次使用 SQLite 在线备份 API 获取一致性快照并执行 PRAGMA integrity_check。
ADMIN_BACKUP_ENABLED=true
ADMIN_BACKUP_INTERVAL_SECONDS=86400
ADMIN_BACKUP_RETENTION=30
ADMIN_BACKUP_DIRECTORY=./data/backups

# 宿主机磁盘监控。容器内默认监控 DATABASE_PATH 所在目录（生产通常为 /app/data）。
# SMTP密码/授权码只从服务端环境变量读取，不会写入数据库、日志或返回控制台。
SYSTEM_MONITOR_ENABLED=true
SYSTEM_MONITOR_PATH=
SYSTEM_MONITOR_SAMPLE_INTERVAL_SECONDS=60
SYSTEM_MONITOR_PERSIST_INTERVAL_SECONDS=300
SYSTEM_MONITOR_RETENTION_DAYS=30
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
ALERT_EMAIL_RECIPIENTS=
# 可选 ssl（默认，常用端口465）或 starttls（常用端口587）。
SMTP_SECURITY=ssl
SMTP_TIMEOUT_SECONDS=10

# 只填写实际需要跨域访问业务 API 的浏览器前端域名，逗号分隔。
# 管理控制台固定使用同源 /api/internal/*，不依赖 CORS。
# 本地开发时还可加入 http://localhost:3002 和 http://127.0.0.1:3002
CORS_ORIGINS=https://video.example.com
# 仅在需要通过局域网地址调试时配置；生产环境通常留空
CORS_ORIGIN_REGEX=

# 公网生产环境建议关闭；本地开发需要 Swagger 时临时设为 true
ENABLE_API_DOCS=false
UPSTREAM_TIMEOUT_SECONDS=30
